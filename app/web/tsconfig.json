{
    "compilerOptions": {
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "ignoreDeprecations": "6.0",
        "baseUrl": ".",
        "types": [
            "vite/client" 
        ],
        "paths": {
            "~/*": [
                "./src/*"
            ],
            "~assets/*": [
                "./src/assets/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "src/**/*.vue",
        "src/**/*.d.ts"
, "src/composables/useHashColor.ts"    ],
    "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
    "references": [
        {
            "path": "./tsconfig.node.json"
        }
    ]
}