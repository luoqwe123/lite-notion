// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
 
}

datasource db {
  provider = "mysql"

}


// 导入所有模块

// 1. 用户表
model User {
  id              Int    @id @default(autoincrement())
  email           String    @unique
  password        String
  nickname        String
  avatar          String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  teams           Team[]            @relation("TeamOwner")
  teamMembers     TeamMember[]
  documents       Document[]        @relation("DocumentCreator")
  updatedDocs     Document[]        @relation("DocumentUpdater")
  versions        DocumentVersion[]
  docPermissions  DocumentPermission[]
  favorites       Favorite[]
  aiLogs          AiLog[]
  importLogs      ImportsLog[]

  @@map("users")
}





// 7. 全局权限表
model Permission {
  id              Int   @id @default(autoincrement())
  role            Role
  canCreate       Int      @default(0) @map("can_create")
  canEdit         Int      @default(0) @map("can_edit")
  canDelete       Int      @default(0) @map("can_delete")
  canManageMember Int      @default(0) @map("can_manage_member")

  @@map("permissions")
}

// 8. 文档独立权限
model DocumentPermission {
  id            Int     @id @default(autoincrement())
  documentId    Int    @map("document_id")
  userId        Int    @map("user_id")
  permission    DocPerm
  expireAt      DateTime?  @map("expire_at")

  document      Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
  @@map("document_permissions")
}



// 9. 收藏表
model Favorite {
  id          Int   @id @default(autoincrement())
  userId      Int   @map("user_id")
  documentId  Int   @map("document_id")
  tags        Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id])
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId])
  @@map("favorites")
}



enum DocPerm {
  view
  edit
}
enum Role {
  admin
  editor
  viewer
  creator
}


// 2. 团队表
model Team {
  id              Int    @id @default(autoincrement())
  name            String
  description     String?
  avatar          String?
  ownerId         Int    @map("owner_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  owner           User              @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  knowledgeBases  KnowledgeBase[]

  @@map("teams")
}
// 3. 团队成员（多对多）
model TeamMember {
  id        Int    @id @default(autoincrement())
  teamId    Int    @map("team_id")
  userId    Int    @map("user_id")
  role      Role      @default(viewer)
  joinedAt  DateTime  @default(now()) @map("joined_at")

  team      Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}


// 4. 知识库
model KnowledgeBase {
  id          Int    @id @default(autoincrement())
  name        String
  teamId      Int   @map("team_id")
  sort        Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  documents   Document[]
  importLogs  ImportsLog[]

  @@map("knowledge_bases")
}


// 5. 文档表（核心）
model Document {
  id          Int        @id @default(autoincrement())
  title       String
  content     String?    @db.Text
  kbId        Int        @map("kb_id")
  teamId      Int        @map("team_id")
  parentId    Int?       @map("parent_id")
  level       Int           @default(1)
  createdBy   Int        @map("created_by")
  updatedBy   Int?       @map("updated_by")
  status      DocStatus     @default(normal)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at")

  creator          User                  @relation("DocumentCreator", fields: [createdBy], references: [id])
  updater          User?                 @relation("DocumentUpdater", fields: [updatedBy], references: [id])
  kb               KnowledgeBase         @relation(fields: [kbId], references: [id], onDelete: Cascade)
  versions         DocumentVersion[]
  permissions      DocumentPermission[]
  favorites        Favorite[]
  aiLogs           AiLog[]

  @@index([kbId], name: "idx_kb")
  @@index([teamId], name: "idx_team")
  @@map("documents")
}



// 6. 文档版本
model DocumentVersion {
  id            Int    @id @default(autoincrement())
  documentId    Int    @map("document_id")
  content       String
  versionNum    Int       @map("version_num")
  createdBy     Int    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  creator       User      @relation(fields: [createdBy], references: [id])

  @@index([documentId], name: "idx_doc")
  @@map("document_versions")
}
enum DocStatus {
  normal
  recycle
}

// 10. AI 日志
model AiLog {
  id          Int   @id @default(autoincrement())
  userId      Int   @map("user_id")
  documentId  Int?  @map("document_id")
  action      AiAction
  content     String
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id])
  document    Document? @relation(fields: [documentId], references: [id])

  @@map("ai_logs")
}

enum AiAction {
  summary
  translate
  rewrite
  outline
  explain
}

// 11. 文件导入日志
model ImportsLog {
  id          Int        @id @default(autoincrement())
  userId      Int        @map("user_id")
  kbId        Int        @map("kb_id")
  fileName    String        @map("file_name")
  fileType    String        @map("file_type")
  status      ImportStatus
  createdAt   DateTime      @default(now()) @map("created_at")

  user        User          @relation(fields: [userId], references: [id])
  kb          KnowledgeBase @relation(fields: [kbId], references: [id])

  @@map("imports_logs")
}

enum ImportStatus {
  success
  fail
}

// 验证码表
model VerifyCode {
  id        Int      @id @default(autoincrement())
  email     String
  code      String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("verify_codes")
}